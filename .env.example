# Server Configuration
PORT=5000
NODE_ENV=development
LOG_LEVEL=info
APP_URL="http://localhost:3000"
WHITELIST_ORIGINS="http://localhost:3000,https://admin.example.com"
TRUST_PROXY="1"
BACKUP_SCHEDULER_INTERVAL_MS=60000
MEMBERSHIP_RENEWAL_SCHEDULER_INTERVAL_MS=86400000

# Logtail Configuration
LOGTAIL_SOURCE_TOKEN=""
LOGTAIL_INGESTING_HOST=""

# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/noynay_db"

# JWT Configuration
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# Email Configuration
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# Passkey / WebAuthn Configuration
PASSKEY_RP_NAME="Pearl of the Orient"
PASSKEY_RP_ID="localhost"
PASSKEY_EXPECTED_ORIGINS="http://localhost:3000,https://admin.example.com"

# Uploadthing (File Storage)
UPLOADTHING_TOKEN=""
