generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ACCOUNTS SCHEMA
// ─────────────────────────────────────────────

model User {
  id    String @id @default(uuid())
  name  String
  email String @unique

  password String
  avatar   String?

  position      UserPosition?
  accountStatus UserAccountStatus @default(ACTIVE)

  isEmailVerified    Boolean  @default(false)
  isTwoFactorEnabled Boolean  @default(false)
  twoFactorSecret    String?
  role               UserType @default(MEMBER)

  userTokens           UserToken[]
  sessions             Session[]
  activityLogs         ActivityLog[]
  verificationCodes    VerificationCode[]
  passkeyCredentials   PasskeyCredential[]
  passkeyChallenge     PasskeyChallenge?
  memberProfile        Member?
  followedMembers      MemberFollow[]
  createdBackups       DatabaseBackupSnapshot[] @relation("CreatedDatabaseBackups")
  restoredBackups      DatabaseBackupSnapshot[] @relation("RestoredDatabaseBackups")
  backupSettingUpdates DatabaseBackupSettings[] @relation("BackupSettingsUpdatedBy")
  assignedTasks        TaskItem[]               @relation("TaskAssignee")
  seminaryInstructor   SeminaryInstructor?
  authoredMemos        MemoAnnouncement[]       @relation("MemoAnnouncementAuthor")
  memoRecipients       MemoRecipient[]          @relation("MemoRecipientUser")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserToken {
  id           String   @id @default(uuid())
  refreshToken String   @unique
  expiredAt    DateTime

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sessionId String  @unique
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([sessionId])
}

model Session {
  id        String   @id @default(uuid())
  ipAddress String?
  userAgent String?
  expiredAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  userToken UserToken?

  @@index([userId])
}

model ActivityLog {
  id String @id @default(uuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  actorName   String
  actorEmail  String
  actorAvatar String?

  actionType  ActivityLogActionType
  actionLabel String
  moduleLabel String
  targetLabel String
  description String
  result      ActivityLogResult

  ipAddress   String?
  deviceLabel String?
  metadata    Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([actionType])
  @@index([moduleLabel])
  @@index([result])
  @@index([createdAt])
}

model VerificationCode {
  id        String           @id @default(uuid())
  code      String?          @unique
  type      VerificationType
  expiresAt DateTime
  createdAt DateTime         @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  @@index([userId])
}

model PasskeyCredential {
  id String @id @default(uuid())

  credentialID String   @unique
  publicKey    Bytes
  counter      Int      @default(0)
  deviceType   String
  backedUp     Boolean  @default(false)
  transports   String[]
  label        String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model PasskeyChallenge {
  id String @id @default(uuid())

  type      PasskeyChallengeType
  challenge String
  expiresAt DateTime

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// MEMBER PROFILE SCHEMA
// ─────────────────────────────────────────────

model Member {
  id       String  @id @default(uuid())
  uniqueId String? @unique // FORMAT: 262-00037 (Recent) = [YR][CODE if officer (1), if member (2)]-[SERIES (incremental)]
  userId   String  @unique
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  status     MemberStatus @default(PENDING)
  memberType MemberType   @default(ASSOCIATE_CHAPLAIN)

  badgeNumber            String?
  profileBannerUrl       String?
  profileBannerPositionY Int     @default(50)

  // Contact Information
  firstName         String
  middleInitial     String?
  lastName          String
  extensionName     String?
  mobilePhoneNumber String?
  homeAddress       String?
  civilStatus       CivilStatus?
  gender            Gender
  nationality       String?
  dateOfBirth       DateTime
  // age is derived from dateOfBirth in backend — not stored

  // Location
  region           String?
  province         String?
  municipalityCity String?
  barangay         String?

  emergencyContactName   String?
  emergencyContactMobile String?

  // Church Background
  churchAffiliation        String?
  churchAddress            String?
  currentPositionRole      String?
  currentPositionRoleOther String?

  // Optional personal details
  height        String?
  weight        String?
  bloodType     String?
  colorOfEyes   String?
  colorOfSkin   String?
  sssNumber     String?
  tinNumber     String?
  skillsTalents String?

  preferredBranches    BranchOfService[]
  preferredBranchOther String?

  // Education
  elementarySchool    String?
  secondarySchool     String?
  tertiaryCollege     String?
  postGraduateStudies String?

  // Relations
  ministerialExperiences     MinisterialExperience[]
  characterReferences        CharacterReference[]
  applicantRequirements      ApplicantRequirement[]
  onboardingProgress         MemberOnboardingProgress?
  paymentCheckout            MemberPaymentCheckout?
  onlineInterviewAppointment MemberOnlineInterviewAppointment?
  idGenerationAsset          MemberIdGenerationAsset?
  certificates               MemberCertificate[]
  credentialDocuments        MemberCredentialDocument[]
  publicRecords              MemberPublicRecord[]
  chaplaincyTrainingProgress MemberChaplaincyTrainingProgress?
  signature                  ApplicantSignature?
  seminaryApplications       SeminaryApplication[]
  officerAssignments         OfficerAssignment[]
  eventAttendances           EventAttendee[]
  taggedEvents               EventTaggedMember[]
  taggedNewsBlogs            NewsBlogTaggedMember[]
  memoRecipients             MemoRecipient[]                   @relation("MemoRecipientMember")
  followers                  MemberFollow[]

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MemberFollow {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, memberId])
  @@index([userId])
  @@index([memberId])
}

model MinisterialExperience {
  id              String @id @default(uuid())
  roleDescription String
  yearsApprox     String
  order           Int

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CharacterReference {
  id                   String @id @default(uuid())
  name                 String
  positionRelationship String
  contactNumber        String
  order                Int

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApplicantSignature {
  id            String        @id @default(uuid())
  type          SignatureType
  signatureData String

  memberId String @unique
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApplicantRequirement {
  id           String                   @id @default(uuid())
  type         ApplicantRequirementType
  reviewStatus RequirementReviewStatus  @default(PENDING)
  fileUrl      String
  fileName     String?
  mimeType     String?

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([memberId, type])
  @@index([memberId])
}

model MemberOnboardingProgress {
  id String @id @default(uuid())

  currentStep                      MemberOnboardingStep @default(REQUIREMENTS)
  preOrientationCompletedLessonIds Int[]                @default([])
  preOrientationCompletedAt        DateTime?

  memberId String @unique
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MemberPaymentCheckout {
  id String @id @default(uuid())

  paymentMethod     MemberPaymentMethod
  proofOfPaymentUrl String?
  isPromissoryNote  Boolean             @default(false)
  promissoryNoteUrl String?
  submittedAt       DateTime            @default(now())

  memberId String @unique
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MemberOnlineInterviewAppointment {
  id String @id @default(uuid())

  interviewerId   String
  interviewerName String
  day             InterviewDay
  timeSlot        String
  zoomLink        String
  meetingId       String?
  passcode        String?
  confirmedAt     DateTime     @default(now())

  memberId String @unique
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MemberIdGenerationAsset {
  id String @id @default(uuid())

  profileUrl  String
  qrCodeUrl   String
  generatedAt DateTime @default(now())

  memberId String @unique
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MemberCertificate {
  id String @id @default(uuid())

  credentialId   String   @unique
  title          String
  certificateUrl String
  dateReceived   DateTime

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId, dateReceived])
}

model MemberCredentialDocument {
  id String @id @default(uuid())

  documentNumber    String                         @unique
  barcodeNumber     String?                        @unique
  verificationToken String                         @unique
  type              MemberCredentialDocumentType
  status            MemberCredentialDocumentStatus @default(ACTIVE)
  title             String?
  issuedAt          DateTime                       @default(now())

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([memberId, type])
  @@index([type, status])
  @@index([documentNumber])
  @@index([barcodeNumber])
  @@index([verificationToken])
  @@index([issuedAt])
}

model MemberPublicRecord {
  id String @id @default(uuid())

  title            String
  shortDescription String
  type             MemberPublicRecordType
  eventAt          DateTime
  location         String
  status           MemberPublicRecordStatus @default(PUBLISHED)

  memberId    String
  member      Member                         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  attachments MemberPublicRecordAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId, eventAt])
  @@index([type])
  @@index([status])
}

model MemberPublicRecordAttachment {
  id String @id @default(uuid())

  fileUrl   String
  fileName  String?
  mimeType  String?
  sortOrder Int     @default(0)

  publicRecordId String
  publicRecord   MemberPublicRecord @relation(fields: [publicRecordId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([publicRecordId, sortOrder])
}

model MemberChaplaincyTrainingProgress {
  id String @id @default(uuid())

  completedLessonIds Int[]     @default([])
  essayAnswers       Json      @default("{}")
  completedAt        DateTime?

  memberId String @unique
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// SEMINARY APPLICATION SCHEMA
// ─────────────────────────────────────────────

model SeminaryApplication {
  id String @id @default(uuid())

  status            SeminaryApplicationStatus @default(SUBMITTED)
  targetMemberType  MemberType                @default(PROFESSIONAL_CHAPLAIN)
  admissionNumber   String?                   @unique
  studentId         String?                   @unique
  studentStatus     SeminaryStudentStatus     @default(ACTIVE)
  enrollmentType    SeminaryEnrollmentType    @default(REGULAR)
  schoolAffiliation SeminarySchoolAffiliation @default(IN_HOUSE)
  yearLevel         String?

  // Personal Information
  academicYear   String?
  surname        String?
  givenName      String?
  middleName     String?
  emailAddress   String?
  mobilePhone    String?
  mailingAddress String?
  homeAddress    String?
  dateOfBirth    DateTime?
  birthPlace     String?
  age            Int?
  gender         Gender?
  height         String?
  weight         String?
  civilStatus    CivilStatus?
  officePhone    String?

  // Ministry
  churchAttended   String?
  churchAddress    String?
  pastorName       String?
  contactNumber    String?
  ministryInvolved String?

  // Curriculum of Interest
  programLevel  SeminaryProgramLevel?
  programCourse String?

  // Educational Background
  highSchool              String?
  highSchoolYearGraduated String?
  collegeSchool           String?
  collegeCourse           String?
  collegeYearGraduated    String?
  vocationalSchool        String?
  vocationalCourse        String?
  vocationalYearGraduated String?
  othersSchool            String?
  othersCourse            String?
  othersYearGraduated     String?

  submittedAt   DateTime  @default(now())
  reviewedAt    DateTime?
  reviewRemarks String?

  memberId String?
  member   Member? @relation(fields: [memberId], references: [id], onDelete: Cascade)

  requirements        SeminaryRequirements?
  payment             SeminaryPayment?
  credentialDocuments SeminaryCredentialDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId])
  @@index([status])
  @@index([targetMemberType])
  @@index([admissionNumber])
  @@index([createdAt])
}

model SeminaryCredentialDocument {
  id String @id @default(uuid())

  documentNumber    String                           @unique
  barcodeNumber     String?                          @unique
  verificationToken String                           @unique
  type              SeminaryCredentialDocumentType
  status            SeminaryCredentialDocumentStatus @default(ACTIVE)
  title             String?
  remarks           String?
  issuedAt          DateTime                         @default(now())
  revokedAt         DateTime?

  applicationId String
  application   SeminaryApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationId])
  @@index([type])
  @@index([status])
  @@index([issuedAt])
}

model SeminaryRequirements {
  id String @id @default(uuid())

  transcriptOfRecordsUrl      String?
  transcriptOfRecordsFileName String?
  transcriptOfRecordsMimeType String?
  transcriptOfRecordsFileSize String?

  idPictureUrl      String?
  idPictureFileName String?
  idPictureMimeType String?
  idPictureFileSize String?

  pastorRecommendationUrl      String?
  pastorRecommendationFileName String?
  pastorRecommendationMimeType String?
  pastorRecommendationFileSize String?

  briefHistoryOfConversion String?

  applicationId String              @unique
  application   SeminaryApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SeminaryPayment {
  id String @id @default(uuid())

  paymentType    SeminaryPaymentType
  paymentMethod  SeminaryPaymentMethod
  amountPaid     Decimal               @db.Decimal(12, 2)
  totalAmountDue Decimal               @db.Decimal(12, 2)
  status         SeminaryPaymentStatus @default(PENDING)
  submittedAt    DateTime              @default(now())
  verifiedAt     DateTime?
  reviewRemarks  String?

  proofOfReceiptUrl      String?
  proofOfReceiptFileName String?
  proofOfReceiptMimeType String?
  proofOfReceiptFileSize String?

  applicationId String              @unique
  application   SeminaryApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model SeminaryCourse {
  id String @id @default(uuid())

  courseName String
  courseCode String                 @unique
  program    SeminaryProgramLevel
  units      Int
  modality   SeminaryCourseModality
  subjects   Json                   @default("[]")
  status     SeminaryCourseStatus   @default(ACTIVE)
  sortOrder  Int                    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([program])
  @@index([modality])
  @@index([status])
  @@index([sortOrder])
}

model SeminaryStudyMaterial {
  id String @id @default(uuid())

  title            String
  subtitle         String?
  subject          String
  type             SeminaryStudyMaterialType
  status           SeminaryStudyMaterialStatus @default(DRAFT)
  fileUrl          String
  fileName         String
  mimeType         String?
  fileSize         Int?
  downloads        Int                         @default(0)
  uploadedByName   String
  uploadedByRole   String
  uploadedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subject])
  @@index([type])
  @@index([status])
  @@index([uploadedByUserId])
  @@index([createdAt])
}

model SeminaryAssignment {
  id String @id @default(uuid())

  title                  String
  description            String
  subject                String
  courseId               String?
  courseName             String?
  courseCode             String?
  instructorUserId       String?
  instructorName         String
  assignmentType         String
  dueAt                  DateTime
  status                 SeminaryAssignmentStatus @default(DRAFT)
  totalMarks             Int
  additionalInstructions String?
  allowLateSubmission    Boolean                  @default(true)
  lateSubmissionDeadline DateTime?
  notifyStudents         Boolean                  @default(true)
  attachmentLabel        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subject])
  @@index([courseId])
  @@index([instructorUserId])
  @@index([status])
  @@index([dueAt])
}

model SeminaryExamination {
  id String @id @default(uuid())

  title              String
  coverage           String
  subject            String
  courseId           String?
  courseName         String?
  courseCode         String?
  instructorUserId   String?
  instructorName     String
  examType           String
  scheduledAt        DateTime
  durationMinutes    Int
  status             SeminaryExaminationStatus @default(DRAFT)
  totalPoints        Int
  passingScore       Int
  instructions       String?
  randomizeQuestions Boolean                   @default(false)
  showResults        Boolean                   @default(true)
  questions          Json                      @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subject])
  @@index([courseId])
  @@index([instructorUserId])
  @@index([status])
  @@index([scheduledAt])
}

model SeminaryGradeRecord {
  id String @id @default(uuid())

  recordNumber         String                    @unique
  studentApplicationId String?
  studentId            String
  studentName          String
  program              String
  programLevel         SeminaryProgramLevel?
  subject              String
  courseId             String?
  courseTitle          String
  courseCode           String
  instructorUserId     String?
  instructorName       String
  term                 String
  finalGrade           String
  remarks              SeminaryGradeRecordRemark @default(ONGOING)
  status               SeminaryGradeRecordStatus @default(IN_PROGRESS)
  notes                String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentApplicationId])
  @@index([studentId])
  @@index([programLevel])
  @@index([subject])
  @@index([courseId])
  @@index([instructorUserId])
  @@index([status])
  @@index([term])
}

model SeminaryStudentNotification {
  id String @id @default(uuid())

  studentApplicationId String?
  studentId            String?
  studentName          String
  studentEmail         String?
  title                String
  message              String
  type                 SeminaryStudentNotificationType
  assignmentId         String?
  readAt               DateTime?

  createdAt DateTime @default(now())

  @@index([studentApplicationId])
  @@index([studentId])
  @@index([type])
  @@index([assignmentId])
  @@index([readAt])
  @@index([createdAt])
}

model SeminaryAcademicYear {
  id String @id @default(uuid())

  academicYear String                      @unique
  session      SeminaryAcademicYearSession
  status       SeminaryAcademicYearStatus
  startDate    DateTime
  endDate      DateTime
  sortOrder    Int                         @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([session])
  @@index([status])
  @@index([startDate])
  @@index([sortOrder])
}

model SeminaryInstructor {
  id String @id @default(uuid())

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  facultyId         String                   @unique
  name              String
  professionalTitle String
  email             String                   @unique
  contactNumber     String
  teachingPrograms  SeminaryProgramLevel[]   @default([])
  rank              SeminaryInstructorRank
  status            SeminaryInstructorStatus @default(ACTIVE)
  loadUnits         Int                      @default(0)

  biography             String
  educationalBackground String
  areasOfExpertise      String[] @default([])
  credentials           String[] @default([])
  formalPhotoUrl        String

  isFilipinoCitizen              Boolean  @default(true)
  highSchoolGraduateOrEquivalent Boolean  @default(true)
  ministerialExperienceYears     Int
  submissionDeadline             DateTime

  attendanceParticipation     Float
  leadershipCharacter         Float
  ministryCommunityEngagement Float
  knowledgeSkillsAssessment   Float
  professionalConductEthics   Float
  totalScore                  Float
  rating                      String
  rankingClassification       String
  award                       String

  inviteTokenSentAt DateTime?
  inviteAcceptedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([facultyId])
  @@index([userId])
  @@index([name])
  @@index([email])
  @@index([status])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// ORGANIZATIONAL STRUCTURE SCHEMA
// ─────────────────────────────────────────────

model SeminaryGradeConfiguration {
  id String @id @default("default")

  passingEquivalent     String  @default("2.50")
  releaseWindow         String  @default("After dean confirmation")
  weightProfile         String  @default("Standard Coursework")
  completionWindowDays  Int     @default(30)
  approvalWorkflow      Boolean @default(true)
  allowFacultyOverride  Boolean @default(true)
  autoPublishApproved   Boolean @default(false)
  showConditionalRemark Boolean @default(true)
  gradeScale            Json
  criteriaWeights       Json    @default("{\"attendance\":20,\"coursework\":40,\"exam\":40}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SeminaryFeeConfiguration {
  id String @id @default("default")

  feeBreakdowns Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SeminaryFeeCollectionAccount {
  id String @id @default(uuid())

  referenceNumber String                      @unique
  studentId       String                      @unique
  studentName     String
  program         String
  programLevel    SeminaryProgramLevel
  totalCharges    Decimal                     @db.Decimal(12, 2)
  amountPaid      Decimal                     @default(0) @db.Decimal(12, 2)
  balance         Decimal                     @default(0) @db.Decimal(12, 2)
  dueDate         DateTime
  paymentMethod   String
  status          SeminaryFeeCollectionStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([referenceNumber])
  @@index([studentId])
  @@index([studentName])
  @@index([programLevel])
  @@index([status])
  @@index([dueDate])
  @@index([createdAt])
}

model AccountingPayable {
  id String @id @default(uuid())

  billNo        String                  @unique
  supplier      String
  category      String
  billDate      DateTime
  dueDate       DateTime
  reference     String?
  description   String?
  paymentTerms  String?
  paymentMethod String?
  bankAccount   String?
  remarks       String?
  discount      Decimal                 @default(0) @db.Decimal(12, 2)
  tax           Decimal                 @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal                 @default(0) @db.Decimal(12, 2)
  paidAmount    Decimal                 @default(0) @db.Decimal(12, 2)
  status        AccountingPayableStatus @default(OPEN)
  attachments   Json                    @default("[]")

  items AccountingPayableItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([billNo])
  @@index([supplier])
  @@index([category])
  @@index([billDate])
  @@index([dueDate])
  @@index([status])
  @@index([createdAt])
}

model AccountingPayableItem {
  id String @id @default(uuid())

  description String
  category    String?
  quantity    Decimal @default(1) @db.Decimal(12, 2)
  unitCost    Decimal @default(0) @db.Decimal(12, 2)
  amount      Decimal @default(0) @db.Decimal(12, 2)
  sortOrder   Int     @default(0)

  payableId String
  payable   AccountingPayable @relation(fields: [payableId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([payableId])
  @@index([sortOrder])
}

model AccountingReceivable {
  id String @id @default(uuid())

  invoiceNo     String                     @unique
  customer      String
  invoiceDate   DateTime
  dueDate       DateTime
  reference     String?
  description   String?
  paymentTerms  String?
  paymentMethod String?
  bankAccount   String?
  notes         String?
  discount      Decimal                    @default(0) @db.Decimal(12, 2)
  tax           Decimal                    @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal                    @default(0) @db.Decimal(12, 2)
  paidAmount    Decimal                    @default(0) @db.Decimal(12, 2)
  status        AccountingReceivableStatus @default(UNPAID)
  attachments   Json                       @default("[]")

  items AccountingReceivableItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceNo])
  @@index([customer])
  @@index([invoiceDate])
  @@index([dueDate])
  @@index([status])
  @@index([createdAt])
}

model AccountingReceivableItem {
  id String @id @default(uuid())

  description String
  account     String?
  quantity    Decimal @default(1) @db.Decimal(12, 2)
  unitPrice   Decimal @default(0) @db.Decimal(12, 2)
  amount      Decimal @default(0) @db.Decimal(12, 2)
  sortOrder   Int     @default(0)

  receivableId String
  receivable   AccountingReceivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([receivableId])
  @@index([sortOrder])
}

model AccountingAcknowledgementReceipt {
  id String @id @default(uuid())

  receiptNo    String              @unique
  organization ReceiptOrganization
  name         String
  receiptDate  DateTime
  course       String?
  school       String?
  paymentType  ReceiptPaymentType  @default(CASH)
  checkNo      String?
  cashier      String?
  remarks      String?
  totalAmount  Decimal             @default(0) @db.Decimal(12, 2)

  items AccountingAcknowledgementReceiptItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([receiptNo])
  @@index([organization])
  @@index([name])
  @@index([receiptDate])
  @@index([createdAt])
}

model AccountingAcknowledgementReceiptItem {
  id String @id @default(uuid())

  particulars String
  amount      Decimal @default(0) @db.Decimal(12, 2)
  remarks     String?
  sortOrder   Int     @default(0)

  receiptId String
  receipt   AccountingAcknowledgementReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([receiptId])
  @@index([sortOrder])
}

model AccountingLedgerTransaction {
  id String @id @default(uuid())

  transactionNo   String                            @unique
  transactionDate DateTime
  type            AccountingLedgerTransactionType
  party           String
  note            String?
  account         String
  accountNo       String?
  category        String
  debit           Decimal                           @default(0) @db.Decimal(12, 2)
  credit          Decimal                           @default(0) @db.Decimal(12, 2)
  status          AccountingLedgerTransactionStatus
  reference       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([transactionNo])
  @@index([transactionDate])
  @@index([type])
  @@index([status])
  @@index([category])
  @@index([createdAt])
}

model OwnerAccessCredential {
  id String @id @default("owner")

  pinHash     String
  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TaskBoard {
  id String @id @default(uuid())

  title     String
  color     String
  sortOrder Int     @default(0)
  isDefault Boolean @default(false)

  tasks TaskItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@index([createdAt])
}

model TaskItem {
  id String @id @default(uuid())

  code      String       @unique
  title     String
  priority  TaskPriority @default(MEDIUM)
  dueDate   DateTime?
  progress  String       @default("0/1")
  sortOrder Int          @default(0)

  boardId String
  board   TaskBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)

  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([boardId])
  @@index([assigneeId])
  @@index([priority])
  @@index([sortOrder])
  @@index([createdAt])
}

model BranchOfService {
  id          String @id @default(uuid())
  title       String // Prison, Humanitarian
  description String

  sections Json

  member   Member? @relation(fields: [memberId], references: [id])
  memberId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OfficeTitle {
  id          String           @id @default(uuid())
  name        String           @unique
  level       OfficeTitleLevel
  description String?
  maxSlots    Int? // null = unlimited, 1 = Chief Chaplain only

  sections Json
  isActive Boolean @default(true)

  assignments OfficerAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OfficerAssignment {
  id String @id @default(uuid())

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  officeTitleId String
  officeTitle   OfficeTitle @relation(fields: [officeTitleId], references: [id], onDelete: Cascade)

  // Jurisdiction — only the relevant field is set based on level
  department       String? // National level  e.g. "Humanitarian", "Education"
  region           String? // Regional level  e.g. "Region 1", "NCR"
  province         String? // Provincial level e.g. "Bulacan", "Tarlac"
  cityMunicipality String? // City/Municipal level e.g. "Dasmarinas Cavite"
  barangay         String? // Barangay level

  isActive  Boolean   @default(true)
  startDate DateTime  @default(now())
  endDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([memberId, officeTitleId, department, region, province, cityMunicipality, barangay])
  @@index([memberId])
  @@index([officeTitleId])
}

model Event {
  id String @id @default(uuid())

  name     String
  category EventCategory
  type     EventType

  location        String?
  onlineLink      String?
  meetingPlatform EventMeetingPlatform?
  meetingId       String?
  meetingPassword String?

  description  String
  thumbnailUrl String
  organizer    String

  startsAt DateTime
  endsAt   DateTime

  status        EventStatus         @default(SCHEDULED)
  visibility    EventVisibility     @default(PUBLIC)
  attendees     EventAttendee[]
  taggedMembers EventTaggedMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([type])
  @@index([status])
  @@index([startsAt])
}

model EventAttendee {
  id String @id @default(uuid())

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  accessLevel  EventAttendeeAccessLevel  @default(FULL_ACCESS)
  inviteStatus EventAttendeeInviteStatus @default(INVITED)

  invitedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, memberId])
  @@index([eventId])
  @@index([memberId])
}

model EventTaggedMember {
  id String @id @default(uuid())

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  taggedAt DateTime @default(now())

  @@unique([eventId, memberId])
  @@index([eventId])
  @@index([memberId])
}

model NewsBlog {
  id String @id @default(uuid())

  title    String
  caption  String
  isActive Boolean          @default(true)
  status   NewsBlogStatus   @default(DRAFT)
  platform NewsBlogPlatform @default(FACEBOOK)

  hashtags       String[]  @default([])
  facebookPostId String?
  scheduledAt    DateTime?
  publishedAt    DateTime?

  media         NewsBlogMedia[]
  taggedMembers NewsBlogTaggedMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([isActive])
  @@index([platform])
  @@index([facebookPostId])
  @@index([scheduledAt])
  @@index([createdAt])
  @@index([updatedAt])
}

model NewsBlogMedia {
  id String @id @default(uuid())

  newsBlogId String
  newsBlog   NewsBlog @relation(fields: [newsBlogId], references: [id], onDelete: Cascade)

  kind      NewsBlogMediaKind
  fileUrl   String
  fileName  String
  sortOrder Int

  createdAt DateTime @default(now())

  @@index([newsBlogId])
  @@index([sortOrder])
}

model NewsBlogTaggedMember {
  id String @id @default(uuid())

  newsBlogId String
  newsBlog   NewsBlog @relation(fields: [newsBlogId], references: [id], onDelete: Cascade)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  taggedAt DateTime @default(now())

  @@unique([newsBlogId, memberId])
  @@index([newsBlogId])
  @@index([memberId])
}

model MemoAnnouncement {
  id String @id @default(uuid())

  referenceNumber String           @unique
  title           String
  category        MemoTemplateType
  customCategory  String?
  status          MemoStatus       @default(DRAFT)
  summary         String?
  documentName    String
  docxFilePath    String?
  pdfFilePath     String?
  pages           Int?

  authorUserId String?
  authorUser   User?   @relation("MemoAnnouncementAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  recipients   MemoRecipient[]
  attachments  MemoAttachment[]
  deliveryLogs MemoDeliveryLog[]

  @@index([referenceNumber])
  @@index([title])
  @@index([category])
  @@index([status])
  @@index([publishedAt])
  @@index([createdAt])
  @@index([updatedAt])
}

model MemoRecipient {
  id String @id @default(uuid())

  memoId String
  memo   MemoAnnouncement @relation(fields: [memoId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation("MemoRecipientUser", fields: [userId], references: [id], onDelete: SetNull)

  memberId String?
  member   Member? @relation("MemoRecipientMember", fields: [memberId], references: [id], onDelete: SetNull)

  name  String
  email String
  type  MemoRecipientType

  createdAt DateTime @default(now())

  deliveryLogs MemoDeliveryLog[]

  @@unique([memoId, userId])
  @@unique([memoId, memberId])
  @@index([memoId])
  @@index([userId])
  @@index([memberId])
  @@index([email])
}

model MemoAttachment {
  id String @id @default(uuid())

  memoId String
  memo   MemoAnnouncement @relation(fields: [memoId], references: [id], onDelete: Cascade)

  kind     MemoAttachmentKind
  fileName String
  filePath String
  mimeType String
  fileSize Int

  createdAt DateTime @default(now())

  @@index([memoId])
  @@index([kind])
}

model MemoDeliveryLog {
  id String @id @default(uuid())

  memoId String
  memo   MemoAnnouncement @relation(fields: [memoId], references: [id], onDelete: Cascade)

  recipientId String
  recipient   MemoRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  email     String
  status    MemoDeliveryStatus @default(PENDING)
  messageId String?
  error     String?
  sentAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memoId])
  @@index([recipientId])
  @@index([email])
  @@index([status])
}

model DatabaseBackupSettings {
  id String @id @default(uuid())

  automaticBackupEnabled Boolean         @default(true)
  frequency              BackupFrequency @default(DAILY)
  retentionDays          Int             @default(30)
  nextRunAt              DateTime?

  lastUpdatedByUserId String?
  lastUpdatedByUser   User?   @relation("BackupSettingsUpdatedBy", fields: [lastUpdatedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DatabaseBackupSnapshot {
  id String @id @default(uuid())

  fileKey  String?
  fileUrl  String
  fileName String

  source        BackupSnapshotSource @default(MANUAL)
  status        BackupSnapshotStatus @default(READY)
  sizeBytes     Int
  tableCount    Int
  retentionDays Int
  metadata      Json?

  createdByUserId String?
  createdByUser   User?   @relation("CreatedDatabaseBackups", fields: [createdByUserId], references: [id], onDelete: SetNull)

  restoredAt       DateTime?
  restoredByUserId String?
  restoredByUser   User?     @relation("RestoredDatabaseBackups", fields: [restoredByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([source])
  @@index([status])
  @@index([createdAt])
}

