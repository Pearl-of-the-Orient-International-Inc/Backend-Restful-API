generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ACCOUNTS SCHEMA
// ─────────────────────────────────────────────

model User {
  id    String @id @default(uuid())
  name  String
  email String @unique

  password String
  avatar   String?

  position      UserPosition?
  accountStatus UserAccountStatus @default(ACTIVE)

  isEmailVerified    Boolean  @default(false)
  isTwoFactorEnabled Boolean  @default(false)
  twoFactorSecret    String?
  role               UserType @default(MEMBER)

  userTokens         UserToken[]
  sessions           Session[]
  activityLogs       ActivityLog[]
  verificationCodes  VerificationCode[]
  passkeyCredentials PasskeyCredential[]
  passkeyChallenge   PasskeyChallenge?
  memberProfile      Member?
  createdBackups     DatabaseBackupSnapshot[] @relation("CreatedDatabaseBackups")
  restoredBackups    DatabaseBackupSnapshot[] @relation("RestoredDatabaseBackups")
  backupSettingUpdates DatabaseBackupSettings[] @relation("BackupSettingsUpdatedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserToken {
  id           String   @id @default(uuid())
  refreshToken String   @unique
  expiredAt    DateTime

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sessionId String  @unique
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([sessionId])
}

model Session {
  id        String   @id @default(uuid())
  ipAddress String?
  userAgent String?
  expiredAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  userToken UserToken?

  @@index([userId])
}

model ActivityLog {
  id String @id @default(uuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  actorName   String
  actorEmail  String
  actorAvatar String?

  actionType  ActivityLogActionType
  actionLabel String
  moduleLabel String
  targetLabel String
  description String
  result      ActivityLogResult

  ipAddress   String?
  deviceLabel String?
  metadata    Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([actionType])
  @@index([moduleLabel])
  @@index([result])
  @@index([createdAt])
}

model VerificationCode {
  id        String           @id @default(uuid())
  code      String?          @unique
  type      VerificationType
  expiresAt DateTime
  createdAt DateTime         @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  @@index([userId])
}

model PasskeyCredential {
  id String @id @default(uuid())

  credentialID String   @unique
  publicKey    Bytes
  counter      Int      @default(0)
  deviceType   String
  backedUp     Boolean  @default(false)
  transports   String[]
  label        String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model PasskeyChallenge {
  id String @id @default(uuid())

  type      PasskeyChallengeType
  challenge String
  expiresAt DateTime

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// MEMBER PROFILE SCHEMA
// ─────────────────────────────────────────────

model Member {
  id       String  @id @default(uuid())
  uniqueId String? @unique // FORMAT: 262-00037 (Recent) = [YR][CODE if officer (1), if member (2)]-[SERIES (incremental)]
  userId   String  @unique
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  status     MemberStatus @default(PENDING)
  memberType MemberType   @default(ASSOCIATE_CHAPLAIN)

  badgeNumber String?

  // Contact Information
  firstName         String
  middleInitial     String?
  lastName          String
  extensionName     String?
  mobilePhoneNumber String?
  homeAddress       String?
  civilStatus       CivilStatus?
  gender            Gender
  nationality       String?
  dateOfBirth       DateTime
  // age is derived from dateOfBirth in backend — not stored

  // Location
  region           String?
  province         String?
  municipalityCity String?
  barangay         String?

  emergencyContactName   String?
  emergencyContactMobile String?

  // Church Background
  churchAffiliation        String?
  churchAddress            String?
  currentPositionRole      String?
  currentPositionRoleOther String?

  // Optional personal details
  height        String?
  weight        String?
  bloodType     String?
  colorOfEyes   String?
  colorOfSkin   String?
  sssNumber     String?
  tinNumber     String?
  skillsTalents String?

  preferredBranches    BranchOfService[]
  preferredBranchOther String?

  // Education
  elementarySchool    String?
  secondarySchool     String?
  tertiaryCollege     String?
  postGraduateStudies String?

  // Relations
  ministerialExperiences     MinisterialExperience[]
  characterReferences        CharacterReference[]
  applicantRequirements      ApplicantRequirement[]
  onboardingProgress         MemberOnboardingProgress?
  paymentCheckout            MemberPaymentCheckout?
  onlineInterviewAppointment MemberOnlineInterviewAppointment?
  idGenerationAsset          MemberIdGenerationAsset?
  chaplaincyTrainingProgress MemberChaplaincyTrainingProgress?
  signature                  ApplicantSignature?
  officerAssignments         OfficerAssignment[]
  eventAttendances           EventAttendee[]

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MinisterialExperience {
  id              String @id @default(uuid())
  roleDescription String
  yearsApprox     String
  order           Int

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CharacterReference {
  id                   String @id @default(uuid())
  name                 String
  positionRelationship String
  contactNumber        String
  order                Int

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApplicantSignature {
  id            String        @id @default(uuid())
  type          SignatureType
  signatureData String

  memberId String @unique
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApplicantRequirement {
  id           String                   @id @default(uuid())
  type         ApplicantRequirementType
  reviewStatus RequirementReviewStatus  @default(PENDING)
  fileUrl      String
  fileName     String?
  mimeType     String?

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([memberId, type])
  @@index([memberId])
}

model MemberOnboardingProgress {
  id String @id @default(uuid())

  currentStep                      MemberOnboardingStep @default(REQUIREMENTS)
  preOrientationCompletedLessonIds Int[]                @default([])
  preOrientationCompletedAt        DateTime?

  memberId String @unique
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MemberPaymentCheckout {
  id String @id @default(uuid())

  paymentMethod     MemberPaymentMethod
  proofOfPaymentUrl String?
  isPromissoryNote  Boolean             @default(false)
  promissoryNoteUrl String?
  submittedAt       DateTime            @default(now())

  memberId String @unique
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MemberOnlineInterviewAppointment {
  id String @id @default(uuid())

  interviewerId   String
  interviewerName String
  day             InterviewDay
  timeSlot        String
  zoomLink        String
  meetingId       String?
  passcode        String?
  confirmedAt     DateTime     @default(now())

  memberId String @unique
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MemberIdGenerationAsset {
  id String @id @default(uuid())

  profileUrl     String
  qrCodeUrl      String
  certificateUrl String
  generatedAt    DateTime @default(now())

  memberId String @unique
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MemberChaplaincyTrainingProgress {
  id String @id @default(uuid())

  completedLessonIds Int[]     @default([])
  essayAnswers       Json      @default("{}")
  completedAt        DateTime?

  memberId String @unique
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// ORGANIZATIONAL STRUCTURE SCHEMA
// ─────────────────────────────────────────────

model BranchOfService {
  id          String @id @default(uuid())
  title       String // Prison, Humanitarian
  description String

  sections Json

  member   Member? @relation(fields: [memberId], references: [id])
  memberId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OfficeTitle {
  id          String           @id @default(uuid())
  name        String           @unique
  level       OfficeTitleLevel
  description String?
  maxSlots    Int? // null = unlimited, 1 = Chief Chaplain only

  sections Json
  isActive Boolean @default(true)

  assignments OfficerAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OfficerAssignment {
  id String @id @default(uuid())

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  officeTitleId String
  officeTitle   OfficeTitle @relation(fields: [officeTitleId], references: [id], onDelete: Cascade)

  // Jurisdiction — only the relevant field is set based on level
  department       String? // National level  e.g. "Humanitarian", "Education"
  region           String? // Regional level  e.g. "Region 1", "NCR"
  province         String? // Provincial level e.g. "Bulacan", "Tarlac"
  cityMunicipality String? // City/Municipal level e.g. "Dasmarinas Cavite"
  barangay         String? // Barangay level

  isActive  Boolean   @default(true)
  startDate DateTime  @default(now())
  endDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([memberId, officeTitleId, department, region, province, cityMunicipality, barangay])
  @@index([memberId])
  @@index([officeTitleId])
}

model Event {
  id String @id @default(uuid())

  name     String
  category EventCategory
  type     EventType

  location        String?
  onlineLink      String?
  meetingPlatform EventMeetingPlatform?
  meetingId       String?
  meetingPassword String?

  description  String
  thumbnailUrl String
  organizer    String

  startsAt DateTime
  endsAt   DateTime

  status     EventStatus     @default(SCHEDULED)
  visibility EventVisibility @default(PUBLIC)
  attendees  EventAttendee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([type])
  @@index([status])
  @@index([startsAt])
}

model EventAttendee {
  id String @id @default(uuid())

  eventId String
  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  accessLevel EventAttendeeAccessLevel   @default(FULL_ACCESS)
  inviteStatus EventAttendeeInviteStatus @default(INVITED)

  invitedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, memberId])
  @@index([eventId])
  @@index([memberId])
}

model DatabaseBackupSettings {
  id String @id @default(uuid())

  automaticBackupEnabled Boolean         @default(true)
  frequency              BackupFrequency @default(DAILY)
  retentionDays          Int             @default(30)
  nextRunAt              DateTime?

  lastUpdatedByUserId String?
  lastUpdatedByUser   User?   @relation("BackupSettingsUpdatedBy", fields: [lastUpdatedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DatabaseBackupSnapshot {
  id String @id @default(uuid())

  fileKey  String?
  fileUrl  String
  fileName String

  source       BackupSnapshotSource @default(MANUAL)
  status       BackupSnapshotStatus @default(READY)
  sizeBytes    Int
  tableCount   Int
  retentionDays Int
  metadata     Json?

  createdByUserId String?
  createdByUser   User?   @relation("CreatedDatabaseBackups", fields: [createdByUserId], references: [id], onDelete: SetNull)

  restoredAt       DateTime?
  restoredByUserId String?
  restoredByUser   User?   @relation("RestoredDatabaseBackups", fields: [restoredByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([source])
  @@index([status])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserType {
  MEMBER
  OFFICER
  ADMIN
}

enum UserPosition {
  CLERK
  HR
  IT
  ACCOUNTING_FINANCE
  OPERATIONS
  SECRETARIAT
}

enum UserAccountStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

enum ActivityLogActionType {
  AUTH
  CREATE
  UPDATE
  DELETE
  EXPORT
  INVITE
  ASSIGN
  REVIEW
  SECURITY
}

enum ActivityLogResult {
  SUCCESS
  WARNING
  FAILED
}

enum MemberStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MemberType {
  ASSOCIATE_CHAPLAIN
  PROFESSIONAL_CHAPLAIN
  ORDAINED_AND_COMMISSIONED_PRACTITIONER
  CERTIFIED_SPECIALIST_TRAINING_OFFICER_INSTRUCTOR
}

enum VerificationType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  TWO_FACTOR
}

enum PasskeyChallengeType {
  REGISTRATION
  AUTHENTICATION
}

enum CivilStatus {
  SINGLE
  MARRIED
  WIDOWED
  SEPARATED
  ANNULLED
}

enum Gender {
  MALE
  FEMALE
  PREFER_NOT_TO_SAY
}

enum SignatureType {
  DRAWN
  UPLOADED
}

enum ApplicantRequirementType {
  PHOTO_2X2
  HS_BACCALAUREATE_DIPLOMA
  TWO_THREE_YEAR_PROGRAM_DIPLOMA
  MASTERS_DEGREE_DIPLOMA
  DOCTORAL_DEGREE_DIPLOMA
  ORDINATION_CERTIFICATE
  PASTORS_RECOMMENDATION_LETTER
  LETTER_OF_INTENT
  ENDORSEMENT_LETTERS
  MARRIAGE_CONTRACT
  CLEARANCE_BARANGAY
  CLEARANCE_POLICE
  CLEARANCE_NBI
}

enum RequirementReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MemberOnboardingStep {
  REQUIREMENTS
  PRE_ORIENTATION
  PAYMENT_CHECKOUT
  ONLINE_INTERVIEW
  ID_GENERATION
  CHAPLAINCY_101
  OATH_TAKING
}

enum MemberPaymentMethod {
  E_WALLET
  DIRECT_DEBIT
  OVER_THE_COUNTER
  CASH
}

enum InterviewDay {
  SATURDAY
  SUNDAY
}

enum OfficeTitleLevel {
  CHIEF_CHAPLAIN
  NATIONAL_CHAPLAIN_DIRECTOR
  REGIONAL_CHAPLAIN_DIRECTOR
  REGIONAL_DEPUTY_CHAPLAIN_DIRECTOR
  PROVINCIAL_CHAPLAIN_DIRECTOR
  PROVINCIAL_DEPUTY_CHAPLAIN_DIRECTOR
  CITY_CHAPLAIN
  MUNICIPAL_CHAPLAIN
  CITY_MUNICIPAL_DEPUTY_CHAPLAIN
  BARANGAY_CHAPLAIN
  BARANGAY_DEPUTY_CHAPLAIN
}

enum EventCategory {
  CONFERENCE
  OUTREACH
  TRAINING
  WORSHIP
  ORIENTATION
  SEMINAR
  FELLOWSHIP
  PRAYER
  OTHER
}

enum EventType {
  ONSITE
  ONLINE
}

enum EventStatus {
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
}

enum EventVisibility {
  PUBLIC
  PRIVATE
}

enum EventMeetingPlatform {
  ZOOM
  GOOGLE_MEET
  MICROSOFT_TEAMS
  OTHER
}

enum EventAttendeeAccessLevel {
  FULL_ACCESS
}

enum EventAttendeeInviteStatus {
  INVITED
  ACCEPTED
}

enum BackupFrequency {
  HOURLY
  DAILY
  WEEKLY
}

enum BackupSnapshotSource {
  MANUAL
  AUTOMATIC
}

enum BackupSnapshotStatus {
  READY
  IN_PROGRESS
  FAILED
}
