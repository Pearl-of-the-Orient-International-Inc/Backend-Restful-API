generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ACCOUNTS SCHEMA
// ─────────────────────────────────────────────

model User {
  id    String @id @default(uuid())
  name  String
  email String @unique

  password String
  avatar   String?

  position      UserPosition?
  accountStatus UserAccountStatus @default(ACTIVE)

  isEmailVerified    Boolean  @default(false)
  isTwoFactorEnabled Boolean  @default(false)
  twoFactorSecret    String?
  role               UserType @default(MEMBER)

  userTokens               UserToken[]
  sessions                 Session[]
  activityLogs             ActivityLog[]
  verificationCodes        VerificationCode[]
  passkeyCredentials       PasskeyCredential[]
  passkeyChallenge         PasskeyChallenge?
  memberProfile            Member?
  followedMembers          MemberFollow[]
  createdBackups           DatabaseBackupSnapshot[]      @relation("CreatedDatabaseBackups")
  restoredBackups          DatabaseBackupSnapshot[]      @relation("RestoredDatabaseBackups")
  backupSettingUpdates     DatabaseBackupSettings[]      @relation("BackupSettingsUpdatedBy")
  assignedTasks            TaskItem[]                    @relation("TaskAssignee")
  seminaryInstructor       SeminaryInstructor?
  seminaryStudentPortal    SeminaryApplication?          @relation("SeminaryStudentPortalAccount")
  seminaryAnnouncements    SeminaryAnnouncement[]        @relation("SeminaryAnnouncementCreator")
  authoredMemos            MemoAnnouncement[]            @relation("MemoAnnouncementAuthor")
  memoRecipients           MemoRecipient[]               @relation("MemoRecipientUser")
  bulletinEntries          BulletinEntry[]               @relation("BulletinEntryAuthor")
  chaplainProductOrders    ChaplainProductOrder[]        @relation("ChaplainProductOrderCustomer")
  serviceBookings          ChaplainServiceBooking[]      @relation("ChaplainServiceBookingRequester")
  ordinationReviews        OrdinationApplicationReview[] @relation("OrdinationApplicationReviewer")
  crasmReviews             CrasmApplicationReview[]      @relation("CrasmApplicationReviewer")
  reviewedDocumentRequests SeminaryDocumentRequest[]     @relation("SeminaryDocumentRequestReviewer")
  releasedDocumentRequests SeminaryDocumentRequest[]     @relation("SeminaryDocumentRequestReleaser")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserToken {
  id           String   @id @default(uuid())
  refreshToken String   @unique
  expiredAt    DateTime

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sessionId String  @unique
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([sessionId])
}

model Session {
  id        String   @id @default(uuid())
  ipAddress String?
  userAgent String?
  expiredAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  userToken UserToken?

  @@index([userId])
}

model ActivityLog {
  id String @id @default(uuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  actorName   String
  actorEmail  String
  actorAvatar String?

  actionType  ActivityLogActionType
  actionLabel String
  moduleLabel String
  targetLabel String
  description String
  result      ActivityLogResult

  ipAddress   String?
  deviceLabel String?
  metadata    Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([actionType])
  @@index([moduleLabel])
  @@index([result])
  @@index([createdAt])
}

model VerificationCode {
  id        String           @id @default(uuid())
  code      String?          @unique
  type      VerificationType
  expiresAt DateTime
  createdAt DateTime         @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  @@index([userId])
}

model PasskeyCredential {
  id String @id @default(uuid())

  credentialID String   @unique
  publicKey    Bytes
  counter      Int      @default(0)
  deviceType   String
  backedUp     Boolean  @default(false)
  transports   String[]
  label        String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model PasskeyChallenge {
  id String @id @default(uuid())

  type      PasskeyChallengeType
  challenge String
  expiresAt DateTime

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// MEMBER PROFILE SCHEMA
// ─────────────────────────────────────────────

model Member {
  id                    String    @id @default(uuid())
  uniqueId              String?   @unique // FORMAT: 262-00037 (Recent) = [YR][CODE if officer (1), if member (2)]-[SERIES (incremental)]
  referralCode          String?   @unique
  referralCodeCreatedAt DateTime?
  referredByMemberId    String?
  referredByMember      Member?   @relation("MemberReferralSource", fields: [referredByMemberId], references: [id], onDelete: SetNull)
  referredMembers       Member[]  @relation("MemberReferralSource")
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  status     MemberStatus @default(PENDING)
  memberType MemberType   @default(ASSOCIATE_CHAPLAIN)

  badgeNumber            String?
  profileBannerUrl       String?
  profileBannerPositionY Int     @default(50)
  serviceLicenseUrl      String?
  serviceLicenseFileName String?
  serviceLicenseMimeType String?

  // Contact Information
  firstName         String
  middleInitial     String?
  lastName          String
  extensionName     String?
  mobilePhoneNumber String?
  homeAddress       String?
  civilStatus       CivilStatus?
  gender            Gender
  nationality       String?
  dateOfBirth       DateTime
  // age is derived from dateOfBirth in backend — not stored

  // Location
  region           String?
  province         String?
  municipalityCity String?
  barangay         String?

  emergencyContactName   String?
  emergencyContactMobile String?

  // Church Background
  churchAffiliation        String?
  churchAddress            String?
  currentPositionRole      String?
  currentPositionRoleOther String?

  // Optional personal details
  height        String?
  weight        String?
  bloodType     String?
  colorOfEyes   String?
  colorOfSkin   String?
  sssNumber     String?
  tinNumber     String?
  skillsTalents String?

  preferredBranches    BranchOfService[]
  preferredBranchOther String?

  // Education
  elementarySchool    String?
  secondarySchool     String?
  tertiaryCollege     String?
  postGraduateStudies String?

  // Relations
  ministerialExperiences     MinisterialExperience[]
  characterReferences        CharacterReference[]
  applicantRequirements      ApplicantRequirement[]
  onboardingProgress         MemberOnboardingProgress?
  paymentCheckout            MemberPaymentCheckout?
  onlineInterviewAppointment MemberOnlineInterviewAppointment?
  idGenerationAsset          MemberIdGenerationAsset?
  certificates               MemberCertificate[]
  credentialDocuments        MemberCredentialDocument[]
  publicRecords              MemberPublicRecord[]
  chaplaincyTrainingProgress MemberChaplaincyTrainingProgress?
  signature                  ApplicantSignature?
  seminaryApplications       SeminaryApplication[]
  officerAssignments         OfficerAssignment[]
  eventAttendances           EventAttendee[]
  taggedEvents               EventTaggedMember[]
  taggedNewsBlogs            NewsBlogTaggedMember[]
  memoRecipients             MemoRecipient[]                   @relation("MemoRecipientMember")
  followers                  MemberFollow[]
  ordinationApplication      OrdinationApplication?
  crasmApplication           CrasmApplication?
  providedServiceBookings    ChaplainServiceBooking[]          @relation("ChaplainServiceBookingProvider")
  serviceAvailabilitySlots   ChaplainServiceAvailability[]
  referralPointEntries       ReferralPointLedgerEntry[]        @relation("ReferralPointReferrer")
  referralMilestoneEntries   ReferralPointLedgerEntry[]        @relation("ReferralPointReferred")

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([referredByMemberId])
}

model ReferralPointCriterion {
  id              String                     @id @default(uuid())
  key             String                     @unique
  label           String
  description     String?
  points          Int
  isActive        Boolean                    @default(true)
  oncePerReferred Boolean                    @default(true)
  monthlyCap      Int?
  sortOrder       Int                        @default(0)
  entries         ReferralPointLedgerEntry[]
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@index([isActive, sortOrder])
}

model ReferralPointLedgerEntry {
  id               String                   @id @default(uuid())
  referrerMemberId String
  referrerMember   Member                   @relation("ReferralPointReferrer", fields: [referrerMemberId], references: [id], onDelete: Cascade)
  referredMemberId String
  referredMember   Member                   @relation("ReferralPointReferred", fields: [referredMemberId], references: [id], onDelete: Cascade)
  criterionId      String
  criterion        ReferralPointCriterion   @relation(fields: [criterionId], references: [id], onDelete: Restrict)
  points           Int
  occurredAt       DateTime
  periodKey        String
  sourceType       String
  sourceId         String
  status           ReferralPointEntryStatus @default(EARNED)
  note             String?
  createdByUserId  String?
  createdAt        DateTime                 @default(now())

  @@unique([criterionId, referredMemberId, sourceType, sourceId])
  @@index([referrerMemberId, periodKey, status])
  @@index([referredMemberId])
  @@index([periodKey, status])
}

model ReferralRecognitionPeriod {
  id             String    @id @default(uuid())
  periodKey      String    @unique
  startsAt       DateTime
  endsAt         DateTime
  isLocked       Boolean   @default(false)
  lockedAt       DateTime?
  lockedByUserId String?
  winners        Json      @default("[]")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model MemberFollow {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, memberId])
  @@index([userId])
  @@index([memberId])
}

model MinisterialExperience {
  id              String @id @default(uuid())
  roleDescription String
  yearsApprox     String
  order           Int

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CharacterReference {
  id                   String @id @default(uuid())
  name                 String
  positionRelationship String
  contactNumber        String
  order                Int

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApplicantSignature {
  id            String        @id @default(uuid())
  type          SignatureType
  signatureData String

  memberId String @unique
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApplicantRequirement {
  id           String                   @id @default(uuid())
  type         ApplicantRequirementType
  reviewStatus RequirementReviewStatus  @default(PENDING)
  fileUrl      String
  fileName     String?
  mimeType     String?

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([memberId, type])
  @@index([memberId])
}

model MemberOnboardingProgress {
  id String @id @default(uuid())

  currentStep                      MemberOnboardingStep @default(REQUIREMENTS)
  preOrientationCompletedLessonIds Int[]                @default([])
  preOrientationCompletedAt        DateTime?

  memberId String @unique
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MemberPaymentCheckout {
  id String @id @default(uuid())

  paymentMethod     MemberPaymentMethod
  proofOfPaymentUrl String?
  isPromissoryNote  Boolean             @default(false)
  promissoryNoteUrl String?
  submittedAt       DateTime            @default(now())

  memberId String @unique
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MemberOnlineInterviewAppointment {
  id String @id @default(uuid())

  interviewerId   String
  interviewerName String
  day             InterviewDay
  timeSlot        String
  zoomLink        String
  meetingId       String?
  passcode        String?
  confirmedAt     DateTime     @default(now())

  memberId String @unique
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MemberIdGenerationAsset {
  id String @id @default(uuid())

  profileUrl  String
  qrCodeUrl   String
  generatedAt DateTime @default(now())

  memberId String @unique
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MemberCertificate {
  id String @id @default(uuid())

  credentialId    String                @unique
  type            MemberCertificateType @default(CERTIFICATE)
  title           String
  issuer          String
  referenceNumber String
  certificateUrl  String
  dateReceived    DateTime
  expiresAt       DateTime?

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId, dateReceived])
}

model MemberCredentialDocument {
  id String @id @default(uuid())

  documentNumber    String                         @unique
  barcodeNumber     String?                        @unique
  verificationToken String                         @unique
  type              MemberCredentialDocumentType
  status            MemberCredentialDocumentStatus @default(ACTIVE)
  title             String?
  issuedAt          DateTime                       @default(now())

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([memberId, type])
  @@index([type, status])
  @@index([documentNumber])
  @@index([barcodeNumber])
  @@index([verificationToken])
  @@index([issuedAt])
}

model MemberPublicRecord {
  id String @id @default(uuid())

  title            String
  shortDescription String
  type             MemberPublicRecordType
  eventAt          DateTime
  location         String
  status           MemberPublicRecordStatus @default(PUBLISHED)

  memberId    String
  member      Member                         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  attachments MemberPublicRecordAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId, eventAt])
  @@index([type])
  @@index([status])
}

model MemberPublicRecordAttachment {
  id String @id @default(uuid())

  fileUrl   String
  fileName  String?
  mimeType  String?
  sortOrder Int     @default(0)

  publicRecordId String
  publicRecord   MemberPublicRecord @relation(fields: [publicRecordId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([publicRecordId, sortOrder])
}

model MemberChaplaincyTrainingProgress {
  id String @id @default(uuid())

  completedLessonIds Int[]     @default([])
  essayAnswers       Json      @default("{}")
  completedAt        DateTime?

  memberId String @unique
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// SEMINARY APPLICATION SCHEMA
// ─────────────────────────────────────────────

model SeminaryApplication {
  id String @id @default(uuid())

  status            SeminaryApplicationStatus @default(SUBMITTED)
  targetMemberType  MemberType                @default(PROFESSIONAL_CHAPLAIN)
  admissionNumber   String?                   @unique
  studentId         String?                   @unique
  studentStatus     SeminaryStudentStatus     @default(ACTIVE)
  enrollmentType    SeminaryEnrollmentType    @default(REGULAR)
  schoolAffiliation SeminarySchoolAffiliation @default(IN_HOUSE)
  yearLevel         String?

  // Personal Information
  academicYear   String?
  surname        String?
  givenName      String?
  middleName     String?
  emailAddress   String?
  mobilePhone    String?
  mailingAddress String?
  homeAddress    String?
  dateOfBirth    DateTime?
  birthPlace     String?
  age            Int?
  gender         Gender?
  height         String?
  weight         String?
  civilStatus    CivilStatus?
  officePhone    String?

  // Ministry
  churchAttended   String?
  churchAddress    String?
  pastorName       String?
  contactNumber    String?
  ministryInvolved String?

  // Curriculum of Interest
  programLevel  SeminaryProgramLevel?
  programCourse String?

  // Educational Background
  highSchool              String?
  highSchoolYearGraduated String?
  collegeSchool           String?
  collegeCourse           String?
  collegeYearGraduated    String?
  vocationalSchool        String?
  vocationalCourse        String?
  vocationalYearGraduated String?
  othersSchool            String?
  othersCourse            String?
  othersYearGraduated     String?

  submittedAt   DateTime  @default(now())
  reviewedAt    DateTime?
  reviewRemarks String?

  memberId String?
  member   Member? @relation(fields: [memberId], references: [id], onDelete: Cascade)

  // A Seminary student account is separate from the public Member portal.
  // Its username is the generated student ID and it is created automatically
  // when a registrar creates the student record.
  portalUserId String? @unique
  portalUser   User?   @relation("SeminaryStudentPortalAccount", fields: [portalUserId], references: [id], onDelete: SetNull)

  requirements        SeminaryRequirements?
  payment             SeminaryPayment?
  credentialDocuments SeminaryCredentialDocument[]
  documentRequests    SeminaryDocumentRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId])
  @@index([portalUserId])
  @@index([status])
  @@index([targetMemberType])
  @@index([admissionNumber])
  @@index([createdAt])
}

model SeminaryCredentialDocument {
  id String @id @default(uuid())

  documentNumber    String                           @unique
  barcodeNumber     String?                          @unique
  verificationToken String                           @unique
  type              SeminaryCredentialDocumentType
  status            SeminaryCredentialDocumentStatus @default(ACTIVE)
  title             String?
  remarks           String?
  issuedAt          DateTime                         @default(now())
  revokedAt         DateTime?

  applicationId String
  application   SeminaryApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationId])
  @@index([type])
  @@index([status])
  @@index([issuedAt])
}

model SeminaryRequirements {
  id String @id @default(uuid())

  transcriptOfRecordsUrl      String?
  transcriptOfRecordsFileName String?
  transcriptOfRecordsMimeType String?
  transcriptOfRecordsFileSize String?

  idPictureUrl      String?
  idPictureFileName String?
  idPictureMimeType String?
  idPictureFileSize String?

  pastorRecommendationUrl      String?
  pastorRecommendationFileName String?
  pastorRecommendationMimeType String?
  pastorRecommendationFileSize String?

  briefHistoryOfConversion String?

  applicationId String              @unique
  application   SeminaryApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SeminaryPayment {
  id String @id @default(uuid())

  paymentType    SeminaryPaymentType
  paymentMethod  SeminaryPaymentMethod
  amountPaid     Decimal               @db.Decimal(12, 2)
  totalAmountDue Decimal               @db.Decimal(12, 2)
  status         SeminaryPaymentStatus @default(PENDING)
  submittedAt    DateTime              @default(now())
  verifiedAt     DateTime?
  reviewRemarks  String?

  proofOfReceiptUrl      String?
  proofOfReceiptFileName String?
  proofOfReceiptMimeType String?
  proofOfReceiptFileSize String?

  applicationId String              @unique
  application   SeminaryApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model SeminaryCourse {
  id String @id @default(uuid())

  courseName String
  courseCode String                   @unique
  program    SeminaryProgramLevel
  units      Int
  modality   SeminaryCourseModality
  subjects   Json                     @default("[]")
  status     SeminaryCourseStatus     @default(ACTIVE)
  sortOrder  Int                      @default(0)
  schedules  SeminaryCourseSchedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([program])
  @@index([modality])
  @@index([status])
  @@index([sortOrder])
}

model SeminaryCourseSchedule {
  id String @id @default(uuid())

  period       String
  academicYear String
  className    String
  courseId     String
  instructorId String
  subjectName  String
  units        Int

  // A schedule can be a one-time meeting (scheduledDate) or recur on one or
  // more weekdays within the academic year.
  scheduledDate     DateTime?
  recurrenceDays    String[]                     @default([])
  recurrenceEndDate DateTime?
  startTime         String
  endTime           String
  deliveryMode      SeminaryCourseModality
  location          String?
  meetingLink       String?
  status            SeminaryCourseScheduleStatus @default(SCHEDULED)

  course     SeminaryCourse     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructor SeminaryInstructor @relation(fields: [instructorId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([period, className])
  @@index([academicYear, className])
  @@index([courseId])
  @@index([instructorId])
  @@index([status])
}

model SeminaryAnnouncement {
  id String @id @default(uuid())

  title    String
  summary  String?
  kind     SeminaryAnnouncementKind     @default(ANNOUNCEMENT)
  category SeminaryAnnouncementCategory @default(ADMINISTRATION)
  audience SeminaryAnnouncementAudience @default(ALL)
  location String?
  allDay   Boolean                      @default(false)
  startsAt DateTime
  endsAt   DateTime?
  status   SeminaryAnnouncementStatus   @default(PUBLISHED)

  createdByUserId String
  createdByUser   User   @relation("SeminaryAnnouncementCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startsAt])
  @@index([status])
  @@index([audience])
  @@index([createdByUserId])
}

model SeminaryDocumentRequestType {
  id String @id @default(uuid())

  name                      String   @unique
  description               String?
  fee                       Decimal? @db.Decimal(12, 2)
  requiresSupportingDetails Boolean  @default(false)
  isActive                  Boolean  @default(true)
  sortOrder                 Int      @default(0)

  requests SeminaryDocumentRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

model SeminaryDocumentRequest {
  id String @id @default(uuid())

  referenceNumber   String                         @unique
  purpose           String
  deliveryMethod    SeminaryDocumentDeliveryMethod
  supportingDetails String?
  fee               Decimal?                       @db.Decimal(12, 2)
  paymentStatus     SeminaryDocumentPaymentStatus  @default(NOT_APPLICABLE)
  status            SeminaryDocumentRequestStatus  @default(PENDING)

  reviewedAt       DateTime?
  reviewRemarks    String?
  processedAt      DateTime?
  readyAt          DateTime?
  releasedAt       DateTime?
  releaseReference String?
  receivedBy       String?

  documentTypeId String
  documentType   SeminaryDocumentRequestType @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)

  studentApplicationId String
  studentApplication   SeminaryApplication @relation(fields: [studentApplicationId], references: [id], onDelete: Cascade)

  reviewedByUserId String?
  reviewedByUser   User?   @relation("SeminaryDocumentRequestReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  releasedByUserId String?
  releasedByUser   User?   @relation("SeminaryDocumentRequestReleaser", fields: [releasedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentApplicationId])
  @@index([documentTypeId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model SeminaryStudyMaterial {
  id String @id @default(uuid())

  title            String
  subtitle         String?
  subject          String
  type             SeminaryStudyMaterialType
  status           SeminaryStudyMaterialStatus @default(DRAFT)
  fileUrl          String
  fileName         String
  mimeType         String?
  fileSize         Int?
  downloads        Int                         @default(0)
  uploadedByName   String
  uploadedByRole   String
  uploadedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subject])
  @@index([type])
  @@index([status])
  @@index([uploadedByUserId])
  @@index([createdAt])
}

model SeminaryAssignment {
  id String @id @default(uuid())

  title                  String
  description            String
  subject                String
  courseId               String?
  courseName             String?
  courseCode             String?
  instructorUserId       String?
  instructorName         String
  assignmentType         String
  dueAt                  DateTime
  status                 SeminaryAssignmentStatus @default(DRAFT)
  totalMarks             Int
  additionalInstructions String?
  allowLateSubmission    Boolean                  @default(true)
  lateSubmissionDeadline DateTime?
  notifyStudents         Boolean                  @default(true)
  attachmentLabel        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subject])
  @@index([courseId])
  @@index([instructorUserId])
  @@index([status])
  @@index([dueAt])
}

model SeminaryExamination {
  id String @id @default(uuid())

  title              String
  coverage           String
  subject            String
  courseId           String?
  courseName         String?
