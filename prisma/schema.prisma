  providerCheckoutUrl String?

  status              ChaplainOrderStatus @default(PENDING)
  inventoryReleasedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  paymentTransactions PaymentTransaction[]

  @@index([productId])
  @@index([customerUserId])
  @@index([customerEmail])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model PaymentTransaction {
  id               String                   @id @default(uuid())
  reference        String                   @unique
  amount           Decimal                  @db.Decimal(12, 2)
  currency         String                   @default("PHP")
  purpose          PaymentPurpose
  payerReference   String
  gateway          PaymentGateway
  gatewayReference String?                  @unique
  checkoutUrl      String?
  status           PaymentTransactionStatus @default(PENDING)
  providerStatus   String?
  failureReason    String?
  metadata         Json?
  paidAt           DateTime?
  expiresAt        DateTime?

  chaplainProductOrderId String?
  chaplainProductOrder   ChaplainProductOrder? @relation(fields: [chaplainProductOrderId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chaplainProductOrderId])
  @@index([gateway])
  @@index([status])
  @@index([payerReference])
  @@index([createdAt])
}

model MemoAnnouncement {
  id String @id @default(uuid())

  referenceNumber String           @unique
  title           String
  category        MemoTemplateType
  customCategory  String?
  status          MemoStatus       @default(DRAFT)
  summary         String?
  documentName    String
  docxFilePath    String?
  pdfFilePath     String?
  pages           Int?

  authorUserId String?
  authorUser   User?   @relation("MemoAnnouncementAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  reviewedAt       DateTime?
  reviewedByUserId String?
  reviewNotes      String?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  recipients   MemoRecipient[]
  attachments  MemoAttachment[]
  deliveryLogs MemoDeliveryLog[]

  @@index([referenceNumber])
  @@index([title])
  @@index([category])
  @@index([status])
  @@index([publishedAt])
  @@index([createdAt])
  @@index([updatedAt])
}

model MemoRecipient {
  id String @id @default(uuid())

  memoId String
  memo   MemoAnnouncement @relation(fields: [memoId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation("MemoRecipientUser", fields: [userId], references: [id], onDelete: SetNull)

  memberId String?
  member   Member? @relation("MemoRecipientMember", fields: [memberId], references: [id], onDelete: SetNull)

  name  String
  email String
  type  MemoRecipientType

  createdAt DateTime @default(now())

  deliveryLogs MemoDeliveryLog[]

  @@unique([memoId, userId])
  @@unique([memoId, memberId])
  @@index([memoId])
  @@index([userId])
  @@index([memberId])
  @@index([email])
}

model MemoAttachment {
  id String @id @default(uuid())

  memoId String
  memo   MemoAnnouncement @relation(fields: [memoId], references: [id], onDelete: Cascade)

  kind     MemoAttachmentKind
  fileName String
  filePath String
  mimeType String
  fileSize Int

  createdAt DateTime @default(now())

  @@index([memoId])
  @@index([kind])
}

model MemoDeliveryLog {
  id String @id @default(uuid())

  memoId String
  memo   MemoAnnouncement @relation(fields: [memoId], references: [id], onDelete: Cascade)

  recipientId String
  recipient   MemoRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  email     String
  status    MemoDeliveryStatus @default(PENDING)
  messageId String?
  error     String?
  sentAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memoId])
  @@index([recipientId])
  @@index([email])
  @@index([status])
}

model DatabaseBackupSettings {
  id String @id @default(uuid())

  automaticBackupEnabled Boolean         @default(true)
  frequency              BackupFrequency @default(DAILY)
  retentionDays          Int             @default(30)
  nextRunAt              DateTime?

  lastUpdatedByUserId String?
  lastUpdatedByUser   User?   @relation("BackupSettingsUpdatedBy", fields: [lastUpdatedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DatabaseBackupSnapshot {
  id String @id @default(uuid())

  fileKey  String?
  fileUrl  String
  fileName String

  source        BackupSnapshotSource @default(MANUAL)
  status        BackupSnapshotStatus @default(READY)
  sizeBytes     Int
  tableCount    Int
  retentionDays Int
  metadata      Json?

  createdByUserId String?
  createdByUser   User?   @relation("CreatedDatabaseBackups", fields: [createdByUserId], references: [id], onDelete: SetNull)

  restoredAt       DateTime?
  restoredByUserId String?
  restoredByUser   User?     @relation("RestoredDatabaseBackups", fields: [restoredByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([source])
  @@index([status])
  @@index([createdAt])
}

